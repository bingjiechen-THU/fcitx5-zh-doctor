#!/bin/sh
set -e

DICT_DIR=/usr/share/fcitx5/pinyin/dictionaries
SRC=/usr/share/fcitx5-zh-doctor/zhwiki.txt.xz

build_dict() {
    [ -f "$SRC" ] || return 0
    command -v libime_pinyindict >/dev/null 2>&1 || {
        echo "fcitx5-zh-doctor: libime-bin missing, skipping dictionary" >&2
        return 0
    }
    mkdir -p "$DICT_DIR"
    tmpdir=$(mktemp -d)
    if xz -dc "$SRC" > "$tmpdir/zhwiki.txt"; then
        if libime_pinyindict "$tmpdir/zhwiki.txt" "$tmpdir/zhwiki.dict" 2>"$tmpdir/err"; then
            mv "$tmpdir/zhwiki.dict" "$DICT_DIR/zhwiki.dict"
            chmod 644 "$DICT_DIR/zhwiki.dict"
        else
            echo "fcitx5-zh-doctor: dictionary build failed: $(tail -n 1 "$tmpdir/err")" >&2
        fi
    fi
    rm -rf "$tmpdir"
}

set_system_im() {
    f=/etc/X11/xinit/xinputrc
    if [ -f "$f" ] && grep -q "run_im fcitx5" "$f"; then
        return 0
    fi
    [ -f "$f" ] && cp -f "$f" "$f.fcitx5-zh-doctor.bak"
    cat > "$f" <<'XINPUTRC'
# generated by fcitx5-zh-doctor
run_im fcitx5
XINPUTRC
}

case "$1" in
    configure)
        build_dict
        set_system_im
        fc-cache -f >/dev/null 2>&1 || true
        ;;
esac

exit 0
