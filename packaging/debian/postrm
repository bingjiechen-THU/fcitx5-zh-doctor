#!/bin/sh
set -e

case "$1" in
    purge)
        rm -f /usr/share/fcitx5/pinyin/dictionaries/zhwiki.dict
        f=/etc/X11/xinit/xinputrc
        if [ -f "$f" ] && grep -q "generated by fcitx5-zh-doctor" "$f"; then
            if [ -f "$f.fcitx5-zh-doctor.bak" ]; then
                mv -f "$f.fcitx5-zh-doctor.bak" "$f"
            else
                printf '# im-config fallback\nrun_im default\n' > "$f"
            fi
        fi
        ;;
esac

exit 0
